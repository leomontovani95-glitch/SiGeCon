# Copie este arquivo para `.env` e ajuste os valores.
#   Bash:       cp .env.example .env
#   PowerShell: Copy-Item .env.example .env

# Banco de dados local (SQLite). Para uso padrão, mantenha como está.
DATABASE_URL="file:./dev.db"

# Chave de assinatura da sessão (JWT). Use uma string ALEATÓRIA de 32+ caracteres.
# TROQUE o valor abaixo por um próprio antes de usar.
SESSION_SECRET="troque-por-uma-chave-aleatoria-de-32-ou-mais-caracteres"
