generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id               String   @id @default(cuid())
  fullName         String
  warName          String
  rank             String
  rg               String   @unique
  functionalNumber String   @unique
  email            String?  @unique
  passwordHash     String
  cpf              String?  @unique
  escola           String   @default("TODAS")
  role             String   @default("PROTOCOLO")
  additionalRoles  String   @default("")
  active           Boolean  @default(true)
  mustChangePassword Boolean @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  opinions          Opinion[]
  decisions         Decision[]
  reportedComms     Communication[]    @relation("Reporter")
  communicantComms  Communication[]    @relation("Communicant")
  auditLogs         AuditLog[]
  disciplinaryBooks DisciplinaryBook[]
  publishedBooks    DisciplinaryBook[] @relation("Publisher")
  student           Student?
  authoredObservations StudentObservation[] @relation("ObservationAuthor")
}

model Course {
  id          String   @id @default(cuid())
  // A sigla (name) pode se repetir entre turmas; o que torna o curso único é a
  // combinação sigla + ano de início (year) — ver @@unique abaixo.
  name        String
  acronym     String
  year        Int?
  description String?
  school      String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  platoons          Platoon[]
  students          Student[]
  communications    Communication[]
  disciplinaryBooks DisciplinaryBook[]

  // Não pode haver dois cursos idênticos (mesma sigla E mesmo ano de início),
  // mesmo que um esteja inativo. Siglas iguais com anos diferentes são válidas.
  @@unique([name, year])
  @@index([school])
}

model Platoon {
  id        String   @id @default(cuid())
  name      String
  courseId  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course         Course          @relation(fields: [courseId], references: [id])
  students       Student[]
  communications Communication[]

  @@index([courseId])
}

model Student {
  id               String   @id @default(cuid())
  fullName         String
  warName          String
  courseId         String
  courseNumber     String
  platoonId        String?
  // rg/cpf NÃO são únicos: a mesma pessoa pode ter vários cadastros (um por
  // curso) ao ascender (ex.: CFO 1 -> CFO 2). O login (User) permanece único e
  // vinculado apenas à matrícula ativa (userId @unique).
  cpf              String?
  userId           String?  @unique
  rg               String
  functionalNumber String?
  email            String?
  status           String   @default("ATIVO")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  course                    Course                   @relation(fields: [courseId], references: [id])
  platoon                   Platoon?                 @relation(fields: [platoonId], references: [id])
  user                      User?                    @relation(fields: [userId], references: [id])
  communications            Communication[]
  acknowledgements          StudentAcknowledgement[]
  defenses                  Defense[]
  disciplinaryBookItems     DisciplinaryBookItem[]
  observations              StudentObservation[]

  @@index([courseId])
  @@index([platoonId])
  @@index([rg])
}

model ManualRule {
  id                      String   @id @default(cuid())
  article                  String
  item                     String?
  letter                   String?
  description              String
  theme                    String?
  defaultCommunicationType String?
  defaultScore             Float?
  // Dispositivo enquadrado como CPI 1 que vale METADE da pontuação (50%).
  // Configurável por dispositivo: ao mudar a legislação, basta marcar/desmarcar
  // aqui sem alterar código. Padrão "Não" (false) na inclusão de novos artigos.
  halfCpi1                 Boolean  @default(false)
  active                   Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  communications Communication[]
}

model CommunicationType {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  score       Float
  scoreNature String   @default("DESFAVORAVEL")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  communications Communication[]
}

model Communication {
  id             String    @id @default(cuid())
  protocolNumber String    @unique
  typeId         String
  studentId      String
  courseId       String
  courseNumber   String
  platoonId      String?
  reporterId     String
  factDate       DateTime
  factTime       String?
  factPlace      String?
  factDescription String
  manualRuleId   String?
  article        String?
  item           String?
  letter         String?
  suggestedScore   Float?
  finalScore       Float?
  // Snapshot, no registro/reenquadramento, de que o dispositivo vale 50% da
  // CPI 1 (vem de ManualRule.halfCpi1). Mantido na comunicação para que a
  // pontuação e a observação do caderno não mudem se a regra for editada depois.
  halfCpi1         Boolean   @default(false)
  // Observação livre do Comandante para a coluna "Observação" do caderno
  // disciplinar — complementa as observações automáticas (não as substitui).
  commanderObservation String?
  status           String    @default("REGISTRADA")
  // Encaminhamento de CPI à decisão do Chefe da Divisão Acadêmica, quando o
  // Comandante da Escola se julga impedido. Guarda o motivo e a data; só então o
  // Chefe da Divisão profere a decisão (status AGUARDANDO_DECISAO_DIVISAO).
  divisionForwardReason String?
  divisionForwardedAt   DateTime?
  defenseDeadline  DateTime?
  communicantName   String?
  communicantUserId String?
  adaptationPeriod  Boolean  @default(false)
  bgpmNumber     String?
  bgpmYear       String?
  tacEquivalent  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  type                  CommunicationType        @relation(fields: [typeId], references: [id])
  student               Student                  @relation(fields: [studentId], references: [id])
  course                Course                   @relation(fields: [courseId], references: [id])
  platoon               Platoon?                 @relation(fields: [platoonId], references: [id])
  reporter              User                     @relation("Reporter", fields: [reporterId], references: [id])
  communicantUser       User?                    @relation("Communicant", fields: [communicantUserId], references: [id])
  manualRule            ManualRule?              @relation(fields: [manualRuleId], references: [id])
  witnesses             Witness[]
  attachments           Attachment[]
  acknowledgements      StudentAcknowledgement[]
  defenses              Defense[]
  opinions              Opinion[]
  decisions             Decision[]
  disciplinaryBookItems DisciplinaryBookItem[]

  @@index([studentId])
  @@index([courseId])
  @@index([status])
  @@index([reporterId])
  @@index([communicantUserId])
}

model Witness {
  id              String  @id @default(cuid())
  communicationId String
  name            String
  rg              String?
  functionalNumber String?
  contact         String?
  notes           String?

  communication Communication @relation(fields: [communicationId], references: [id])

  @@index([communicationId])
}

model Attachment {
  id              String   @id @default(cuid())
  communicationId String
  defenseId       String?
  opinionId       String?
  decisionId      String?
  fileName        String
  filePath        String
  fileType        String?
  uploadedBy      String
  createdAt       DateTime @default(now())

  communication Communication @relation(fields: [communicationId], references: [id])
  defense       Defense?      @relation(fields: [defenseId], references: [id])
  opinion       Opinion?      @relation(fields: [opinionId], references: [id])
  decision      Decision?     @relation(fields: [decisionId], references: [id])

  @@index([communicationId])
}

model StudentAcknowledgement {
  id              String   @id @default(cuid())
  communicationId String
  studentId       String
  acknowledgedAt  DateTime @default(now())
  method          String?
  notes           String?

  communication Communication @relation(fields: [communicationId], references: [id])
  student       Student       @relation(fields: [studentId], references: [id])

  @@index([communicationId])
  @@index([studentId])
}

model Defense {
  id              String   @id @default(cuid())
  communicationId String
  studentId       String
  text            String
  submittedAt     DateTime @default(now())
  isLate          Boolean  @default(false)

  communication Communication  @relation(fields: [communicationId], references: [id])
  student       Student        @relation(fields: [studentId], references: [id])
  attachments   Attachment[]

  @@index([communicationId])
}

model Opinion {
  id              String   @id @default(cuid())
  communicationId String
  authorId        String
  authorRole      String
  text            String
  recommendation  String?
  createdAt       DateTime @default(now())

  communication Communication @relation(fields: [communicationId], references: [id])
  author        User          @relation(fields: [authorId], references: [id])
  attachments   Attachment[]

  @@index([communicationId])
}

model Decision {
  id              String   @id @default(cuid())
  communicationId String
  authorityId     String
  decisionType    String
  text            String
  finalScore      Float?
  decidedAt       DateTime @default(now())

  communication Communication @relation(fields: [communicationId], references: [id])
  authority     User          @relation(fields: [authorityId], references: [id])
  attachments   Attachment[]

  @@index([communicationId])
}

model DisciplinaryBook {
  id              String    @id @default(cuid())
  number          Int
  year            Int
  courseId        String?
  school          String?
  publicationDate DateTime?
  status          String    @default("RASCUNHO")
  createdById     String
  publishedById   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  createdBy   User                   @relation(fields: [createdById], references: [id])
  publishedBy User?                  @relation("Publisher", fields: [publishedById], references: [id])
  course      Course?                @relation(fields: [courseId], references: [id])
  items       DisciplinaryBookItem[]
  aacp        Aacp?

  // Numeração do caderno é única por curso e ano (reinicia a cada ano).
  @@unique([courseId, year, number])
  @@index([status])
}

model Aacp {
  id                 String   @id @default(cuid())
  disciplinaryBookId String   @unique
  local              String   @default("Academia de Polícia Militar do Espírito Santo - APM/ES")
  fiscalizacao       String   @default("Oficial de Dia")
  versao             Int      @default(1)
  saturdayDate       DateTime
  sundayDate         DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  disciplinaryBook   DisciplinaryBook       @relation(fields: [disciplinaryBookId], references: [id], onDelete: Cascade)
  dayGroups          AacpDayGroup[]
  materiais          AacpMaterial[]
  observacoes        AacpObservacao[]
  dispositivosLegais AacpDispositivoLegal[]
}

model AacpDayGroup {
  id       String @id @default(cuid())
  aacpId   String
  day      String
  cpiLabel String
  order    Int

  aacp    Aacp         @relation(fields: [aacpId], references: [id], onDelete: Cascade)
  actions AacpAction[]
}

model AacpAction {
  id      String @id @default(cuid())
  groupId String
  acao    String
  periodo String
  order   Int

  group AacpDayGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model AacpMaterial {
  id     String @id @default(cuid())
  aacpId String
  text   String
  order  Int

  aacp Aacp @relation(fields: [aacpId], references: [id], onDelete: Cascade)
}

model AacpObservacao {
  id     String @id @default(cuid())
  aacpId String
  text   String
  order  Int

  aacp Aacp @relation(fields: [aacpId], references: [id], onDelete: Cascade)
}

model AacpDispositivoLegal {
  id     String @id @default(cuid())
  aacpId String
  text   String
  order  Int

  aacp Aacp @relation(fields: [aacpId], references: [id], onDelete: Cascade)
}

model DisciplinaryBookItem {
  id                  String  @id @default(cuid())
  disciplinaryBookId  String
  communicationId     String
  studentId           String
  courseId            String?
  platoonId           String?
  studentCourseNumber String
  studentWarName      String
  recordType          String
  factDate            DateTime
  decisionSummary     String
  score               Float?
  shortObservation    String?
  originalArticle     String?
  originalItem        String?
  originalLetter      String?

  disciplinaryBook DisciplinaryBook @relation(fields: [disciplinaryBookId], references: [id])
  communication    Communication    @relation(fields: [communicationId], references: [id])
  student          Student          @relation(fields: [studentId], references: [id])

  // Uma comunicação não pode ser lançada duas vezes no mesmo caderno.
  @@unique([disciplinaryBookId, communicationId])
  @@index([studentId])
  @@index([communicationId])
}

// Observações internas no histórico do aluno — registro de fatos relevantes que
// NÃO geram comunicação (CPI/TD), positivos ou negativos. Restrito a Oficial de
// escola para cima (+ Cmt/Subcmt APM, Chefe da Divisão Acadêmica, Administrador);
// NUNCA sai no PDF do histórico nem é visível ao aluno. Ver lib/roles.ts
// (OBSERVACAO_ROLES / canManageObservacoes).
model StudentObservation {
  id                 String    @id @default(cuid())
  studentId          String
  authorId           String
  // Snapshot do papel do autor no momento do registro (auditoria/exibição).
  authorRoleSnapshot String
  // POSITIVA | NEGATIVA | NEUTRA
  nature             String    @default("NEUTRA")
  text               String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  // Preenchido quando o autor (ou o Administrador) edita a observação.
  editedAt           DateTime?

  student     Student                 @relation(fields: [studentId], references: [id])
  author      User                    @relation("ObservationAuthor", fields: [authorId], references: [id])
  attachments ObservationAttachment[]

  @@index([studentId])
  @@index([authorId])
}

model ObservationAttachment {
  id            String   @id @default(cuid())
  observationId String
  fileName      String
  filePath      String
  fileType      String?
  uploadedBy    String
  createdAt     DateTime @default(now())

  observation StudentObservation @relation(fields: [observationId], references: [id])

  @@index([observationId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
}
